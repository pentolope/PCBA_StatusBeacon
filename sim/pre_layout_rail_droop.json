      "stands_in_for": "every bulk and decoupling capacitance on the rail as one ideal capacitor, with no ESR, no ESL and no DC bias derating"
    },
    "RLED": {
      "accepted_for_design_decision": true,
      "stands_in_for": "the LED array's aggregate draw as a fixed resistance at its worst-case current; a constant-current load droops no further than this"
    },
    "RPATH": {
      "accepted_for_design_decision": true,
      "stands_in_for": "the series resistance of the cable, the receptacle contacts and the board copper between the receptacle and the LED ring, as a design budget"
    },
    "SRC": {
      "accepted_for_design_decision": true,
      "stands_in_for": "the USB-C source as an ideal voltage source held at vSafe5V minimum, with no output impedance of its own"
    },
    "SWITCH": {
      "accepted_for_design_decision": true,
      "stands_in_for": "the instant at which firmware turns the whole ring on, as an ideal switch with no on-resistance"
    }
